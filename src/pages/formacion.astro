---
import Emblem from '../components/Emblem.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import TopicGrid from '../components/TopicGrid.astro';
import LeadModal from '../components/LeadModal.astro';
import { inquiryMessage, whatsappUrl } from '../data/formation';

const whatsapp = whatsappUrl(inquiryMessage);
const pains = [
  'Sentís que en tus vínculos se repiten los mismos patrones y querés entender de dónde vienen.',
  'Ya acompañás a otras personas y buscás enfoques que complementen lo que hacés.',
  'Hiciste talleres o cursos sueltos y te falta un recorrido que los integre.',
];
const gains = [
  ['Un recorrido de 12 meses', 'Los cinco enfoques integrados en una misma formación, no como talleres sueltos.'],
  ['Clases en vivo con tu grupo', 'Lunes y miércoles a las 20 h (Argentina), por Google Meet.'],
  ['Material de estudio incluido', 'Para repasar cada bloque a tu ritmo entre clase y clase.'],
];
const facts = [
  ['Duración', '12 meses'],
  ['Modalidad', 'En vivo por Google Meet'],
  ['Días y horario', 'Lunes y miércoles, 20 h (Argentina)'],
  ['Material', 'Material de estudio incluido'],
];
const questions = [
  ['¿Cuándo empieza y cuánto cuesta?', 'Dejá tus datos en «Reservar mi lugar» y te escribimos con la próxima fecha de inicio, el arancel y las opciones de pago.'],
  ['¿Cómo me inscribo?', 'Tocá «Reservar mi lugar» y dejá tus datos. El instituto te contacta por WhatsApp con la disponibilidad y los pasos para inscribirte.'],
  ['¿Quién dicta las clases?', 'El instituto puede confirmarte quién dicta cada parte de la próxima cursada.'],
  ['¿Qué certificación se entrega?', 'El material de difusión menciona una certificación integral. Consultá al instituto por el nombre del certificado, quién lo emite y qué requisitos tiene.'],
  ['¿La formación reemplaza la atención profesional?', 'La propuesta es educativa y de desarrollo personal. La formación no reemplaza la atención médica ni psicológica y no habilita por sí misma para ejercer una profesión de salud.'],
];
---
<SiteLayout
  title="Bio Coaching Sistémico Integral | Instituto Visión en Acción"
  description="Formación de 12 meses en vivo que integra coaching sistémico, constelaciones con tarot, biodescodificación, hipnosis y PNL. Reservá tu lugar en la próxima cursada."
  formation
>
  <section class="site-hero hero-formation">
    <div class="wrap site-hero-grid">
      <div class="hero-copy">
        <h1>Bio Coaching<br />Sistémico Integral</h1>
        <p>En 12 meses conocés cinco enfoques de acompañamiento mientras trabajás tu propia historia. En vivo, en grupo y desde tu casa.</p>
        <a class="button" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
        <p class="cta-note">Te escribimos con la fecha de inicio y el arancel.</p>
      </div>
      <Emblem formation />
    </div>
  </section>
  <div class="facts" id="cursada">
    <dl class="wrap facts-grid">
      {facts.map(([label, value]) => (
        <div><dt>{label}</dt><dd>{value}</dd></div>
      ))}
    </dl>
  </div>
  <section class="wrap section split" id="para-quien" data-reveal>
    <h2>¿Para quién es esta formación?</h2>
    <div>
      <ul class="pain-list">
        {pains.map((pain) => <li>{pain}</li>)}
      </ul>
      <p class="pain-close">Si te reconocés en alguna, este recorrido está pensado para vos.</p>
    </div>
  </section>
  <section class="band" id="programa">
    <div class="wrap section split" data-reveal>
      <div>
        <h2>Cinco enfoques en un solo recorrido</h2>
        <p>Cada bloque suma una mirada distinta sobre tu historia y sobre cómo acompañar a otras personas. Tocá cada enfoque para ver de qué se trata.</p>
        <a class="button button-dark" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
      </div>
      <TopicGrid />
    </div>
  </section>
  <section class="wrap section" id="incluye">
    <h2 data-reveal>Qué incluye la formación</h2>
    <ul class="gain-grid" data-reveal-group>
      {gains.map(([title, text]) => (
        <li><h3>{title}</h3><p>{text}</p></li>
      ))}
    </ul>
  </section>
  <section class="band" id="docentes">
    <div class="wrap section split" data-reveal>
      <h2>Quién dicta la formación</h2>
      <div>
        <p><mark class="pending">Pendiente: nombre, foto y breve presentación de quien dicta cada bloque.</mark></p>
      </div>
    </div>
  </section>
  <section class="wrap section" id="testimonios">
    <h2 data-reveal>Lo que cuentan quienes la hicieron</h2>
    <ul class="quote-grid" data-reveal-group>
      <li><mark class="pending">Pendiente: testimonio real (texto, nombre y cohorte).</mark></li>
      <li><mark class="pending">Pendiente: testimonio real (texto, nombre y cohorte).</mark></li>
      <li><mark class="pending">Pendiente: testimonio real (texto, nombre y cohorte).</mark></li>
    </ul>
  </section>
  <section class="band band-dark" id="oferta">
    <div class="wrap section offer" data-reveal>
      <div>
        <h2>Próxima cursada</h2>
        <p>Los cupos son por grupo. Dejá tus datos y te contactamos para confirmar tu lugar.</p>
      </div>
      <dl class="offer-list">
        <div><dt>Inicio</dt><dd><mark class="pending">Pendiente: fecha</mark></dd></div>
        <div><dt>Cupos</dt><dd><mark class="pending">Pendiente: cantidad</mark></dd></div>
        <div><dt>Arancel</dt><dd><mark class="pending">Pendiente: precio y opciones de pago</mark></dd></div>
        <div><dt>Modalidad</dt><dd>12 meses, en vivo por Google Meet</dd></div>
      </dl>
      <a class="button" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
    </div>
  </section>
  <section class="wrap section split" id="preguntas" data-reveal>
    <h2>Preguntas frecuentes</h2>
    <div class="faq">
      {questions.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="band band-dark">
    <div class="wrap section invitation" data-reveal>
      <h2>Empezá tu formación en la próxima cursada</h2>
      <p>Dejá tus datos y te escribimos con la fecha de inicio, el arancel y los pasos de inscripción.</p>
      <a class="button" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
    </div>
  </section>
  <LeadModal />
</SiteLayout>

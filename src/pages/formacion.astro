---
import SiteLayout from '../layouts/SiteLayout.astro';
import TopicGrid from '../components/TopicGrid.astro';
import LeadModal from '../components/LeadModal.astro';
import { formationName, inquiryMessage, whatsappUrl } from '../data/formation';

const whatsapp = whatsappUrl(inquiryMessage);
const pains = [
  'Sentís que en tus vínculos se repiten los mismos patrones y querés entender de dónde vienen.',
  'Ya acompañás a otras personas y buscás enfoques que complementen lo que hacés.',
  'Hiciste talleres o cursos sueltos y te falta un recorrido que los integre.',
];
const gains = [
  ['Grabaciones disponibles por 30 días', 'Podés volver a ver cada clase para repasar o recuperar un encuentro al que no pudiste asistir.'],
  ['Material de estudio incluido', 'Podés descargar el material de estudio y guardarlo para consultarlo cuando lo necesites.'],
  ['Evaluaciones y certificados', 'El arancel incluye los exámenes y la emisión de los certificados dentro de los plazos establecidos por el instituto.'],
];
const facts = [
  ['Modalidad', 'En vivo por Google Meet'],
  ['Días y horario', 'Lunes y miércoles, 20 hs (Argentina)'],
];
const tuition = [
  ['Enero a abril', 'ARS 60.000', 'USD 70'],
  ['Mayo a agosto', 'ARS 70.000', 'USD 80'],
  ['Septiembre a diciembre', 'ARS 80.000', 'USD 90'],
];
const questions = [
  ['¿Cómo me inscribo?', 'Tocá «Reservar mi lugar» y dejá tus datos. El instituto te contacta por WhatsApp con la disponibilidad y los pasos para inscribirte.'],
  ['¿Hace falta experiencia previa?', 'Podés empezar desde cero. La formación también está abierta a coaches, facilitadores y personas que ya trabajan en el ámbito holístico.'],
  ['¿Quién emite los certificados y qué requisitos tienen?', 'El Instituto Visión en Acción emite los certificados. Para obtenerlos, tenés que cumplir los requisitos académicos de cada formación, aprobar las evaluaciones teóricas y completar las prácticas obligatorias cuando correspondan. Son certificados de formación privada no formal.'],
  ['¿La formación reemplaza la atención profesional?', 'La propuesta es educativa y de desarrollo personal. La formación no reemplaza la atención médica ni psicológica y no habilita por sí misma para ejercer una profesión de salud.'],
];
---
<SiteLayout
  title={`${formationName} | Instituto Visión en Acción`}
  description="Formación de 12 meses en vivo que integra coaching sistémico, constelaciones con tarot, biodescodificación, hipnosis y PNL. Reservá tu lugar en la próxima cursada."
  formation
>
  <section class="site-hero hero-formation">
    <div class="wrap site-hero-grid">
      <div class="hero-copy">
        <h1>{formationName}</h1>
        <p>Aprendé a integrar cinco enfoques de acompañamiento mientras explorás tu propia historia.</p>
        <ul class="formation-hero-facts" role="list">
          <li>12 meses</li>
          <li>Clases en vivo</li>
          <li>Inicio en enero de 2027</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
          <a class="hero-link" href="#docentes">Conocer a los formadores</a>
        </div>
        <p class="cta-note">Te escribimos para confirmar disponibilidad y explicarte cómo inscribirte.</p>
      </div>
      <div class="formation-hero-art" aria-hidden="true">
        <span class="formation-hero-sphere"></span>
        <img
          class="formation-hero-sculpture"
          src="/images/formation-sculpture-base.webp"
          srcset="/images/formation-sculpture-base-mobile.webp 480w, /images/formation-sculpture-base.webp 960w"
          sizes="(max-width: 720px) 18rem, 28rem"
          alt=""
          width="960"
          height="960"
        />
      </div>
    </div>
  </section>
  <div class="facts formation-facts" id="cursada">
    <dl class="wrap facts-grid">
      {facts.map(([label, value]) => (
        <div><dt>{label}</dt><dd>{value}</dd></div>
      ))}
    </dl>
  </div>
  <section class="wrap section split" id="para-quien" data-reveal>
    <h2>¿Para quién es esta formación?</h2>
    <div>
      <ul class="pain-list">
        {pains.map((pain) => <li>{pain}</li>)}
      </ul>
      <p class="pain-close">Si te reconocés en alguna, este recorrido está pensado para vos.</p>
    </div>
  </section>
  <section class="band program-index" id="programa">
    <div class="wrap section split" data-reveal>
      <div>
        <h2>Cinco enfoques en un solo recorrido</h2>
        <p>Cada bloque suma una mirada distinta sobre tu historia y sobre cómo acompañar a otras personas. Tocá cada enfoque para ver de qué se trata.</p>
        <a class="button button-dark" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
      </div>
      <TopicGrid />
    </div>
  </section>
  <section class="wrap section" id="incluye">
    <h2 data-reveal>Qué incluye la formación</h2>
    <ul class="gain-grid" data-reveal-group>
      {gains.map(([title, text]) => (
        <li><h3>{title}</h3><p>{text}</p></li>
      ))}
    </ul>
  </section>
  <section class="band" id="docentes">
    <div class="wrap section" data-reveal>
      <h2>Quién dicta la formación</h2>
      <div class="instructor-list">
        <article class="instructor-profile" aria-labelledby="formadora-fernanda">
          <img
            class="instructor-portrait"
            src="/images/instructor-portrait.jpg"
            alt="Retrato de la formadora"
            width="673"
            height="1437"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3 id="formadora-fernanda">Fernanda Rodríguez</h3>
            <p>Fundadora y directora del instituto, es formadora en desarrollo personal y en el área holística. Su trabajo integra herramientas de autoconocimiento y de exploración de patrones personales y familiares.</p>
          </div>
        </article>
        <article class="instructor-profile" aria-labelledby="formador-holistico">
          <img
            class="instructor-portrait instructor-portrait-holistic"
            src="/images/holistic-instructor-portrait.jpg"
            alt="Retrato de Daniel Alberto Rodríguez"
            width="171"
            height="365"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3 id="formador-holistico">Daniel Alberto Rodríguez</h3>
            <p>Formador del área holística. Su formación incluye tarot y oráculos, constelaciones familiares, biodescodificación, hipnosis y Reiki.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="band band-dark" id="oferta">
    <div class="wrap section offer" data-reveal>
      <div>
        <h2>Próxima cursada</h2>
        <p><strong>Enero de 2027 · Cupos limitados</strong></p>
        <p>Matrícula bonificada. Pagás del 1 al 10 de cada mes por transferencia bancaria en Argentina y PayPal desde el exterior.</p>
      </div>
      <dl class="offer-list" aria-label="Arancel promocional por mes">
        {tuition.map(([period, argentina, international]) => (
          <div><dt>{period}</dt><dd>{argentina} por mes en Argentina<br />{international} por mes desde el exterior</dd></div>
        ))}
      </dl>
      <a class="button" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
    </div>
  </section>
  <section class="wrap section split" id="preguntas" data-reveal>
    <h2>Preguntas frecuentes</h2>
    <div class="faq">
      {questions.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="band band-dark">
    <div class="wrap section invitation" data-reveal>
      <h2>Empezá tu formación en la próxima cursada</h2>
      <p>Dejá tus datos y te escribimos para confirmar disponibilidad y explicarte cómo inscribirte.</p>
      <a class="button" href={whatsapp} data-modal-open="reservar">Reservar mi lugar</a>
    </div>
  </section>
  <LeadModal />
</SiteLayout>

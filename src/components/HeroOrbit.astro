---
// Home hero art: the institute logo floating in a 3D orbit, with the same lilac sphere as the training hero.
// Pure CSS (perspective + preserve-3d), so it costs no image weight. Static under prefers-reduced-motion.
---
<div class="orbit3d" aria-hidden="true">
  <div class="orbit3d-scene">
    <div class="orbit3d-plane">
      <span class="orbit3d-ring orbit3d-ring-outer"></span>
      <span class="orbit3d-ring orbit3d-ring-inner"></span>
      <div class="orbit3d-spin">
        <div class="orbit3d-arm"><span class="orbit3d-sphere"></span></div>
      </div>
      <div class="orbit3d-spin orbit3d-spin-slow">
        <div class="orbit3d-arm orbit3d-arm-inner"><span class="orbit3d-spark"></span></div>
      </div>
    </div>
    <div class="orbit3d-card">
      <img src="/favicon.svg#svgView(viewBox(28,92,310,215))" alt="" width="310" height="215" />
    </div>
    <span class="orbit3d-shadow"></span>
  </div>
  <span class="orbit3d-caption">Ser para hacer, para tener</span>
</div>

---
// Home hero art in a wellness key: a breathing lilac aura, slow water-like ripples and the institute mark
// resting in the center, with the same floating lilac sphere as the training hero.
// Pure CSS; everything holds still under prefers-reduced-motion.
---
<div class="breath" aria-hidden="true">
  <span class="breath-aura"></span>
  <span class="breath-ripple"></span>
  <span class="breath-ripple"></span>
  <span class="breath-ripple"></span>
  <span class="breath-ring"></span>
  <div class="breath-core">
    <img src="/favicon.svg#svgView(viewBox(101,104,153,153))" alt="" width="153" height="153" />
  </div>
  <span class="breath-sphere"></span>
  <span class="breath-caption">Ser para hacer, para tener</span>
</div>

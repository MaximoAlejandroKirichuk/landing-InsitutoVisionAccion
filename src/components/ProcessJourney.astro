---
// ProcessJourney — always-visible editorial section that explains the process after the funnel area.
// Split into small visual blocks (icon cards + chips) so the reader scans instead of reading lists.

const clusters = [
  {
    id: 'bonds',
    title: 'Vínculos',
    summary: 'Cómo te relacionás con otros y con vos.',
    topics: ['Pareja', 'Familia', 'Autoestima', 'Pertenencia'],
  },
  {
    id: 'patterns',
    title: 'Patrones internos',
    summary: 'Lo que se repite y lo que sentís.',
    topics: ['Patrones repetitivos', 'Miedos', 'Emociones', 'Identidad'],
  },
  {
    id: 'direction',
    title: 'Dirección',
    summary: 'Hacia dónde querés ir.',
    topics: ['Propósito', 'Dinero', 'Vocación', 'Decisiones'],
  },
];

const featuredTools = ['Coaching', 'PNL', 'Constelaciones', 'Biodescodificación', 'Mindfulness'];
const moreTools = [
  'Memoria Celular',
  'Hipnosis',
  'Reiki',
  'Tameana',
  'Meditación',
  'Visualizaciones guiadas',
  'Gestión emocional',
  'Reencuadre de creencias',
  'Técnicas de autoconocimiento',
];
---

<section
  class="process-journey surface-sage-wash"
  aria-labelledby="process-journey-heading"
>
  <div class="process-shell">
    <header class="process-header">
      <p class="process-kicker">Método VIA®</p>
      <h2 id="process-journey-heading" class="process-heading" tabindex="-1">
        Camino de Evolución Consciente
      </h2>
      <p class="process-subheading">
        No buscamos cambiar quién sos: ampliamos cómo comprendés lo vivido para elegir con más claridad.
      </p>
    </header>

    <div class="process-topics" aria-label="Temas que suelen aparecer">
      {clusters.map((cluster) => (
        <article class="process-card" aria-labelledby={`process-${cluster.id}`}>
          <span class="process-icon" aria-hidden="true">
            {cluster.id === 'bonds' && (
              <svg viewBox="0 0 24 24"><circle cx="9" cy="12" r="5.5" /><circle cx="15" cy="12" r="5.5" /></svg>
            )}
            {cluster.id === 'patterns' && (
              <svg viewBox="0 0 24 24"><path d="M12 12c0-1.4 1.1-2.5 2.5-2.5S17 10.6 17 12c0 2.8-2.2 5-5 5s-5-2.2-5-5c0-3.9 3.1-7 7-7 3.9 0 7 3.1 7 7" /></svg>
            )}
            {cluster.id === 'direction' && (
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8z" /></svg>
            )}
          </span>
          <h3 id={`process-${cluster.id}`}>{cluster.title}</h3>
          <p>{cluster.summary}</p>
          <ul class="process-chips">
            {cluster.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="process-pair">
      <section class="process-goal" aria-labelledby="process-goal-heading">
        <span class="process-icon process-icon-light" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="0.8" /></svg>
        </span>
        <h3 id="process-goal-heading">El objetivo</h3>
        <p>Transformar lo que hoy vivís en decisiones con más coherencia y libertad.</p>
      </section>

      <section class="process-tools" aria-labelledby="process-tools-heading">
        <span class="process-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 20c-4-2.5-6-5.5-6-9a6 6 0 0 1 6-6 6 6 0 0 1 6 6c0 3.5-2 6.5-6 9Z" /><path d="M12 9v11" /></svg>
        </span>
        <h3 id="process-tools-heading">Recursos que se combinan</h3>
        <p>Cada proceso se arma a tu medida con herramientas como:</p>
        <ul class="process-chips">
          {featuredTools.map((tool) => <li>{tool}</li>)}
        </ul>
        <details class="process-more">
          <summary>Ver los {featuredTools.length + moreTools.length} recursos</summary>
          <ul class="process-chips">
            {moreTools.map((tool) => <li>{tool}</li>)}
          </ul>
        </details>
      </section>
    </div>

    <p class="process-legal">
      Propuesta de desarrollo personal. No es atención médica, psicológica ni psiquiátrica y no reemplaza tratamientos de salud.
    </p>
  </div>
</section>

<style>
  .process-journey {
    padding: clamp(2.5rem, 5vw, 4.5rem) 1.25rem clamp(2.75rem, 6vw, 5rem);
  }

  .process-shell {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .process-header {
    display: grid;
    gap: 0.85rem;
    max-width: 44rem;
  }

  .process-kicker {
    margin: 0;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--via-rust, #b46430);
  }

  .process-heading {
    margin: 0;
    font-size: clamp(2.25rem, 4.4vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--via-night-blue);
    text-wrap: balance;
    outline: none;
  }

  .process-subheading {
    margin: 0;
    max-width: 40ch;
    font-family: var(--ff-heading);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.32;
    color: rgba(50, 26, 70, 0.78);
  }

  .process-topics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .process-card,
  .process-tools,
  .process-goal {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.4vw, 1.6rem);
    border: 1px solid var(--line, #d9cbdc);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--paper, #fbf7f1);
    transition: transform 0.35s var(--ease-out, ease), box-shadow 0.35s var(--ease-out, ease);
  }

  .process-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow, 0 18px 40px -22px rgba(50, 26, 70, 0.35));
  }

  .process-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.25rem;
    border-radius: 999px;
    background: var(--soft, #eee4f1);
    color: var(--plum, #321a46);
  }

  .process-icon svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .process-icon-light {
    background: rgba(236, 201, 132, 0.16);
    color: var(--gold, #ecc984);
  }

  .process-journey h3 {
    margin: 0;
    font-family: var(--display, var(--ff-heading));
    font-size: 1.25rem;
    font-weight: 550;
    line-height: 1.2;
    color: var(--ink, #24152f);
  }

  .process-card p,
  .process-tools p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--body, #4f3e57);
  }

  .process-chips {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .process-chips li {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--soft, #eee4f1);
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--plum, #321a46);
  }

  .process-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1rem;
  }

  .process-goal {
    border-color: transparent;
    background: var(--plum, #321a46);
  }

  .process-journey .process-goal h3 {
    color: var(--gold, #ecc984);
  }

  .process-goal p {
    margin: 0;
    max-width: 26ch;
    font-family: var(--display, var(--ff-heading));
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.3;
    color: #fff;
  }

  .process-more summary {
    width: fit-content;
    margin-top: 0.25rem;
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--plum, #321a46);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .process-more summary:focus-visible {
    outline: 2px solid var(--plum, #321a46);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .process-legal {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgba(50, 26, 70, 0.58);
  }

  @media (max-width: 960px) {
    .process-topics,
    .process-pair {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .process-journey {
      padding: 2rem 1rem 2.4rem;
    }

    .process-heading {
      font-size: clamp(1.7rem, 9vw, 2.3rem);
      line-height: 1.04;
    }

    .process-subheading {
      font-size: 0.98rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-card:hover {
      transform: none;
    }
  }
</style>

---
import { topics, topicInquiry } from '../data/formation';

interface Props {
  /** Prefix keeps dialog ids unique if the grid appears twice on a page. */
  idPrefix?: string;
}
const { idPrefix = 'enfoque' } = Astro.props;

/** Simple line icons (24px grid) so each approach is recognizable at a glance. */
const icons: Record<string, string> = {
  coaching: '<path d="M4 5.5h16v10H9l-5 4z"/><path d="M8.5 9.5h7M8.5 12h4.5"/>',
  tarot: '<rect x="3.5" y="6" width="9" height="13" rx="1.5" transform="rotate(-8 8 12.5)"/><rect x="10" y="4.5" width="9" height="13" rx="1.5" transform="rotate(8 14.5 11)"/><path d="m14.6 8.6.6 1.4 1.5.2-1.1 1 .3 1.5-1.3-.8-1.3.8.3-1.5-1.1-1 1.5-.2z"/>',
  biodescodificacion: '<path d="M12 21v-9"/><path d="M12 12 7.5 8M12 12l4.5-4M12 15.5 8 13M12 15.5l4-2.5"/><circle cx="12" cy="6" r="3"/><path d="M8 21h8"/>',
  hipnosis: '<path d="M12 12c0-1.1.9-2 2-2s2 .9 2 2c0 2.2-1.8 4-4 4s-4-1.8-4-4c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M4 12a8 8 0 0 0 8 8"/>',
  pnl: '<path d="M12 4c-3.9 0-7 2.7-7 6 0 1.6.7 3 1.9 4.1V19l3.3-1.9c.6.1 1.2.2 1.8.2 3.9 0 7-2.7 7-6s-3.1-6-7-6Z"/><path d="M9 10.5c.7-1 2.3-1 3 0s2.3 1 3 0"/>',
};
---
<ul class="topic-grid" data-reveal-group>
  {topics.map((topic) => (
    <li>
      <button
        type="button"
        class="topic-card"
        data-modal-open={`${idPrefix}-${topic.id}`}
        aria-haspopup="dialog"
      >
        <span class="topic-card-head">
          <span class="topic-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={icons[topic.id] ?? ''} />
          </span>
          <span class="topic-card-title">{topic.title}</span>
          <span class="topic-card-summary">{topic.summary}</span>
        </span>
        <span class="topic-card-more">Ver el bloque</span>
      </button>
    </li>
  ))}
</ul>

{topics.map((topic) => (
  <dialog class="modal" id={`${idPrefix}-${topic.id}`} aria-labelledby={`${idPrefix}-${topic.id}-title`}>
    <div class="modal-body">
      <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
      <h3 id={`${idPrefix}-${topic.id}-title`}>{topic.title}</h3>
      <p>{topic.description}</p>
      <p class="modal-note">Pedí el temario de este bloque y la fecha de la próxima cursada.</p>
      <a class="button button-dark" href={topicInquiry(topic)}>Pedir el temario por WhatsApp</a>
    </div>
  </dialog>
))}

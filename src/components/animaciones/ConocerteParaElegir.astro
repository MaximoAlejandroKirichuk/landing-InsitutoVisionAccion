---
// Hero art for /conocerte-para-elegir/: the ebook in 3D. A violet book with a gold title rests closed,
// its cover slowly opens, a few pages turn on their own, and a warm light rises from the open pages
// with small motes floating up; then it closes gently and the cycle starts again (~16 s).
// Pure CSS 3D (transform and opacity only), no libraries. Paused off-screen.
// Under prefers-reduced-motion it shows a still, open book with its light.
// No props (convention of src/components/animaciones/). Styles and script are is:inline so only this page loads them.
---
<div class="conocerte-para-elegir-art" aria-hidden="true">
  <span class="conocerte-para-elegir-glow"></span>
  <div class="conocerte-para-elegir-stage">
    <span class="conocerte-para-elegir-beam"></span>
    <div class="conocerte-para-elegir-slide"><div class="conocerte-para-elegir-book">
      <span class="conocerte-para-elegir-shadow"></span>
      <span class="conocerte-para-elegir-back"></span>
      <span class="conocerte-para-elegir-block"></span>
      <span class="conocerte-para-elegir-light"></span>
      <span class="conocerte-para-elegir-page conocerte-para-elegir-p3"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="conocerte-para-elegir-page conocerte-para-elegir-p2"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="conocerte-para-elegir-page conocerte-para-elegir-p1"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="conocerte-para-elegir-cover">
        <span class="conocerte-para-elegir-front">
          <span class="conocerte-para-elegir-title">Conocerte<small>para</small>Elegir</span>
        </span>
        <span class="conocerte-para-elegir-inside"></span>
      </span>
    </div></div>
    <span class="conocerte-para-elegir-mote" style="--x:-34%;--d:0s;--s:1"></span>
    <span class="conocerte-para-elegir-mote" style="--x:-12%;--d:-.7s;--s:.7"></span>
    <span class="conocerte-para-elegir-mote" style="--x:8%;--d:-1.4s;--s:1.2"></span>
    <span class="conocerte-para-elegir-mote" style="--x:26%;--d:-.35s;--s:.8"></span>
    <span class="conocerte-para-elegir-mote" style="--x:-24%;--d:-1.9s;--s:.9"></span>
    <span class="conocerte-para-elegir-mote" style="--x:18%;--d:-2.4s;--s:.6"></span>
    <span class="conocerte-para-elegir-mote" style="--x:-4%;--d:-2.9s;--s:1"></span>
    <span class="conocerte-para-elegir-mote" style="--x:36%;--d:-1.1s;--s:.7"></span>
  </div>
  <span class="conocerte-para-elegir-caption">Conocerte es el primer paso para elegir</span>
</div>

<style is:inline>
  .conocerte-para-elegir-art {
    --cpe-t: 16s;
    position: relative; width: 100%; aspect-ratio: 1; display: grid; place-items: center; isolation: isolate;
  }
  .conocerte-para-elegir-art > * { grid-area: 1 / 1; }
  .conocerte-para-elegir-glow {
    width: 80%; aspect-ratio: 1; border-radius: 50%; z-index: -1;
    background: radial-gradient(circle, #b98fd650 0%, #7a4f9a30 42%, transparent 70%);
    animation: conocerte-para-elegir-breathe 8s ease-in-out infinite;
  }
  .conocerte-para-elegir-stage {
    position: relative; width: 100%; height: 100%; perspective: 1200px; perspective-origin: 50% 30%;
  }
  .conocerte-para-elegir-slide {
    position: absolute; inset: 0; transform-style: preserve-3d;
    animation: conocerte-para-elegir-slide var(--cpe-t) cubic-bezier(.45, 0, .3, 1) infinite;
  }
  .conocerte-para-elegir-beam {
    position: absolute; left: 50%; top: 4%; width: 46%; height: 58%; translate: -50% 0; border-radius: 50%;
    background: radial-gradient(ellipse at 50% 80%, #fff3d6aa 0%, #ecc98455 30%, #b98fd622 55%, transparent 72%);
    opacity: 0; transition: opacity 2.4s ease;
  }
  .conocerte-para-elegir-art.is-open .conocerte-para-elegir-beam { opacity: 1; }
  .conocerte-para-elegir-book {
    position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d;
    transform: rotateX(48deg) rotateZ(-8deg);
    animation: conocerte-para-elegir-sway calc(var(--cpe-t) / 2) ease-in-out infinite;
  }
  /* Every piece is a 38% x 52% (of the art) slab whose left edge sits on the spine (x = 0). */
  .conocerte-para-elegir-book > span {
    position: absolute; left: 0; top: -26cqh; width: 38cqw; height: 52cqh; transform-style: preserve-3d;
  }
  .conocerte-para-elegir-art { container-type: size; }
  .conocerte-para-elegir-shadow {
    background: radial-gradient(ellipse at 50% 50%, #0d051466, transparent 70%);
    transform: translate3d(-22%, 4%, -14px) scale(1.7, 1.08); filter: blur(10px);
  }
  .conocerte-para-elegir-back {
    border-radius: 2px 10px 10px 2px; transform: translateZ(-1px);
    background: linear-gradient(135deg, #4d2c64, #321a46 60%, #21112d);
  }
  .conocerte-para-elegir-block {
    border-radius: 1px 8px 8px 1px; transform: translateZ(9px) scale(.97);
    background:
      repeating-linear-gradient(90deg, #00000000 0 3px, #d9cbdc55 3px 4px) right / 6px 100% no-repeat,
      linear-gradient(90deg, #efe6ef, #fbf7f1 30%);
    box-shadow: inset 6px 0 10px -6px #32194688;
  }
  .conocerte-para-elegir-light {
    width: 76cqw !important; left: -38cqw !important;
    background: radial-gradient(ellipse at 50% 50%, #fff6e0 0%, #ecc98466 30%, transparent 65%);
    transform: translateZ(12px); opacity: 0;
    animation: conocerte-para-elegir-light var(--cpe-t) ease-in-out infinite;
  }
  .conocerte-para-elegir-page {
    transform-origin: 0 50%; border-radius: 1px 7px 7px 1px;
    background: linear-gradient(90deg, #e9dfea, #fbf7f1 22%);
    transform: translateZ(10px) rotateY(0deg) scale(.96);
    display: flex; flex-direction: column; justify-content: center; gap: 7%; padding: 0 16%;
    box-sizing: border-box; backface-visibility: visible;
  }
  .conocerte-para-elegir-page i { display: block; height: 2px; border-radius: 2px; background: #d9cbdc99; }
  .conocerte-para-elegir-page i:nth-child(even) { width: 78%; }
  .conocerte-para-elegir-page i:last-child { width: 46%; }
  .conocerte-para-elegir-p1 { animation: conocerte-para-elegir-p1 var(--cpe-t) cubic-bezier(.45, 0, .3, 1) infinite; }
  .conocerte-para-elegir-p2 { animation: conocerte-para-elegir-p2 var(--cpe-t) cubic-bezier(.45, 0, .3, 1) infinite; }
  .conocerte-para-elegir-p3 { animation: conocerte-para-elegir-p3 var(--cpe-t) cubic-bezier(.45, 0, .3, 1) infinite; }
  .conocerte-para-elegir-cover {
    transform-origin: 0 50%; transform: translateZ(12px) rotateY(0deg);
    animation: conocerte-para-elegir-cover var(--cpe-t) cubic-bezier(.45, 0, .3, 1) infinite;
  }
  .conocerte-para-elegir-cover > span {
    position: absolute; inset: 0; border-radius: 2px 10px 10px 2px; backface-visibility: hidden;
  }
  .conocerte-para-elegir-front {
    background:
      linear-gradient(90deg, #00000040, transparent 9%),
      linear-gradient(140deg, #6a3f86, #4d2c64 45%, #321a46);
    box-shadow: inset 0 0 0 1px #ecc98455;
    display: grid; place-items: center;
  }
  .conocerte-para-elegir-front::before {
    content: ""; position: absolute; inset: 9%; border: 1px solid #ecc98499; border-radius: 4px;
  }
  .conocerte-para-elegir-title {
    font: 500 clamp(.85rem, 5cqw, 1.5rem)/1.05 var(--display, Georgia, serif);
    color: #ecc984; text-align: center; letter-spacing: .01em; display: grid; gap: .25em;
  }
  .conocerte-para-elegir-title small { font-size: .55em; font-style: italic; color: #fbf7f1cc; }
  .conocerte-para-elegir-inside {
    transform: rotateY(180deg);
    background: linear-gradient(270deg, #e3d6e6, #fbf7f1 25%);
  }
  .conocerte-para-elegir-mote {
    position: absolute; left: calc(50% + var(--x)); top: 46%; width: 9px; height: 9px; border-radius: 50%;
    background: radial-gradient(circle, #fff6e0, #ecc98488 45%, transparent 70%);
    scale: var(--s); opacity: 0;
    animation: conocerte-para-elegir-mote calc(var(--cpe-t) / 4) ease-out var(--d) infinite;
    animation-name: conocerte-para-elegir-mote;
  }
  .conocerte-para-elegir-caption {
    align-self: end; margin-bottom: .2rem; z-index: 1;
    font: italic 400 .95rem/1.3 var(--display, Georgia, serif); color: #ecc984cc; letter-spacing: .02em; text-align: center;
  }

  /* Timeline (16 s): closed 0-12% · cover opens 12-30% · pages turn 30-55% · open with light 55-84% · closes 84-100%. */
  @keyframes conocerte-para-elegir-cover {
    0%, 12% { transform: translateZ(12px) rotateY(0deg); }
    30%, 84% { transform: translateZ(12px) rotateY(-176deg); }
    100% { transform: translateZ(12px) rotateY(0deg); }
  }
  /* Closed, the book is centred; open, the spine is. */
  @keyframes conocerte-para-elegir-slide {
    0%, 12% { transform: translateX(-17cqw); }
    30%, 84% { transform: translateX(0); }
    100% { transform: translateX(-17cqw); }
  }
  @keyframes conocerte-para-elegir-p1 {
    0%, 28% { transform: translateZ(11px) rotateY(0deg) scale(.96); }
    40%, 86% { transform: translateZ(11px) rotateY(-172deg) scale(.96); }
    98%, 100% { transform: translateZ(11px) rotateY(0deg) scale(.96); }
  }
  @keyframes conocerte-para-elegir-p2 {
    0%, 36% { transform: translateZ(10.5px) rotateY(0deg) scale(.96); }
    48%, 87% { transform: translateZ(10.5px) rotateY(-168deg) scale(.96); }
    98%, 100% { transform: translateZ(10.5px) rotateY(0deg) scale(.96); }
  }
  @keyframes conocerte-para-elegir-p3 {
    0%, 43% { transform: translateZ(10px) rotateY(0deg) scale(.96); }
    55%, 88% { transform: translateZ(10px) rotateY(-164deg) scale(.96); }
    98%, 100% { transform: translateZ(10px) rotateY(0deg) scale(.96); }
  }
  @keyframes conocerte-para-elegir-light {
    0%, 24% { opacity: 0; transform: translateZ(12px) scale(.6); }
    45%, 80% { opacity: 1; transform: translateZ(14px) scale(1); }
    92%, 100% { opacity: 0; transform: translateZ(12px) scale(.6); }
  }
  @keyframes conocerte-para-elegir-mote {
    0% { opacity: 0; transform: translate(0, 0); }
    25% { opacity: var(--on, 0); }
    100% { opacity: 0; transform: translate(10px, -34cqh); }
  }
  /* Motes only show while the book is open: the root toggles --on with the timeline. */
  .conocerte-para-elegir-art.is-open .conocerte-para-elegir-mote { --on: .95; }
  @keyframes conocerte-para-elegir-sway {
    0%, 100% { transform: rotateX(48deg) rotateZ(-8deg) translateZ(0); }
    50% { transform: rotateX(44deg) rotateZ(-4deg) translateZ(10px); }
  }
  @keyframes conocerte-para-elegir-breathe { 0%, 100% { scale: .92; opacity: .75; } 50% { scale: 1.06; opacity: 1; } }

  .conocerte-para-elegir-art.is-paused *, .conocerte-para-elegir-art.is-paused { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .conocerte-para-elegir-art * { animation: none !important; }
    .conocerte-para-elegir-cover { transform: translateZ(12px) rotateY(-176deg); }
    .conocerte-para-elegir-p1 { transform: translateZ(11px) rotateY(-172deg) scale(.96); }
    .conocerte-para-elegir-p2 { transform: translateZ(10.5px) rotateY(-168deg) scale(.96); }
    .conocerte-para-elegir-light { opacity: 1; transform: translateZ(14px); }
    .conocerte-para-elegir-mote { display: none; }
    .conocerte-para-elegir-beam { opacity: 1; }
  }
  @media (max-width: 720px) { .conocerte-para-elegir-caption { font-size: .85rem; } }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll('.conocerte-para-elegir-art').forEach((root) => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Pause every CSS animation while off-screen.
      new IntersectionObserver(([e]) => root.classList.toggle('is-paused', !e.isIntersecting)).observe(root);
      // Light motes only while the book is open (45%-84% of the cover's timeline).
      const cover = root.querySelector('.conocerte-para-elegir-cover');
      const tick = () => {
        const anim = cover?.getAnimations?.()[0];
        if (anim && anim.currentTime != null) {
          const p = (anim.currentTime % 16000) / 16000;
          root.classList.toggle('is-open', p > 0.42 && p < 0.84);
        }
        setTimeout(tick, 250);
      };
      tick();
    });
  })();
</script>

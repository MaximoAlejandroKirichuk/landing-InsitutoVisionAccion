---
// Optimización del Tiempo hero art: a glass-and-gold hourglass standing in front of a weekly planner.
// The sand runs down slowly, the hourglass turns over with calm (CSS 3D), and meanwhile the planner's
// blocks settle into place one by one: the week getting in order. Pure SVG + CSS, no JS.
// Only transform and opacity animate. Under prefers-reduced-motion everything holds still, planner complete.
---
<div class="optimizacion-del-tiempo" aria-hidden="true">
  <div class="optimizacion-del-tiempo-escena">
    <!-- Weekly planner, tilted back like a page on a desk -->
    <div class="optimizacion-del-tiempo-agenda">
      <svg viewBox="0 0 400 300" role="presentation" focusable="false">
        <defs>
          <linearGradient id="optimizacion-del-tiempo-papel" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fbf7f1" />
            <stop offset="1" stop-color="#efe4ef" />
          </linearGradient>
        </defs>
        <rect x="8" y="8" width="384" height="284" rx="18" fill="url(#optimizacion-del-tiempo-papel)" />
        <rect x="8" y="8" width="384" height="44" rx="18" fill="#4d2c64" />
        <rect x="8" y="34" width="384" height="18" fill="#4d2c64" />
        <g fill="#ecc984">
          <circle cx="70" cy="8" r="5" /><circle cx="150" cy="8" r="5" /><circle cx="250" cy="8" r="5" /><circle cx="330" cy="8" r="5" />
        </g>
        <g fill="#fbf7f1" font-family="Montserrat, system-ui, sans-serif" font-size="13" font-weight="600" text-anchor="middle" letter-spacing="1">
          <text x="44" y="36">L</text><text x="96" y="36">M</text><text x="148" y="36">M</text><text x="200" y="36">J</text>
          <text x="252" y="36">V</text><text x="304" y="36">S</text><text x="356" y="36">D</text>
        </g>
        <g stroke="#d9cbdc" stroke-width="1">
          <path d="M70 60v220M122 60v220M174 60v220M226 60v220M278 60v220M330 60v220" />
          <path d="M20 115h360M20 170h360M20 225h360" stroke-dasharray="3 5" />
        </g>
        <!-- Blocks that settle in order -->
        <g class="optimizacion-del-tiempo-bloques">
          <rect style="--i:0" x="24" y="66" width="40" height="42" rx="7" fill="#b8913f" />
          <rect style="--i:1" x="128" y="66" width="40" height="96" rx="7" fill="#6d4f85" />
          <rect style="--i:2" x="76" y="122" width="40" height="42" rx="7" fill="#9b7fb0" />
          <rect style="--i:3" x="232" y="66" width="40" height="42" rx="7" fill="#b8913f" />
          <rect style="--i:4" x="180" y="176" width="40" height="42" rx="7" fill="#6d4f85" />
          <rect style="--i:5" x="284" y="122" width="40" height="96" rx="7" fill="#9b7fb0" />
          <rect style="--i:6" x="24" y="231" width="40" height="42" rx="7" fill="#d9c3d6" />
          <rect style="--i:7" x="336" y="231" width="40" height="42" rx="7" fill="#ecc984" />
        </g>
      </svg>
    </div>

    <!-- Hourglass in front -->
    <div class="optimizacion-del-tiempo-reloj">
      <div class="optimizacion-del-tiempo-giro">
        <svg viewBox="0 0 160 240" role="presentation" focusable="false">
          <defs>
            <clipPath id="optimizacion-del-tiempo-arriba"><path d="M36 34 H124 C124 78 92 98 82 118 H78 C68 98 36 78 36 34 Z" /></clipPath>
            <clipPath id="optimizacion-del-tiempo-abajo"><path d="M78 122 H82 C92 142 124 162 124 206 H36 C36 162 68 142 78 122 Z" /></clipPath>
            <linearGradient id="optimizacion-del-tiempo-arena" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f6dca0" />
              <stop offset="1" stop-color="#d9ac5a" />
            </linearGradient>
            <linearGradient id="optimizacion-del-tiempo-vidrio" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fbf7f1" stop-opacity=".28" />
              <stop offset=".35" stop-color="#fbf7f1" stop-opacity=".06" />
              <stop offset="1" stop-color="#fbf7f1" stop-opacity=".18" />
            </linearGradient>
          </defs>
          <!-- glass -->
          <path d="M36 34 H124 C124 78 92 98 82 120 C92 142 124 162 124 206 H36 C36 162 68 142 78 120 C68 98 36 78 36 34 Z" fill="#21112d" fill-opacity=".35" />
          <!-- sand -->
          <g clip-path="url(#optimizacion-del-tiempo-arriba)">
            <rect class="optimizacion-del-tiempo-arena-arriba" x="30" y="58" width="100" height="62" fill="url(#optimizacion-del-tiempo-arena)" />
          </g>
          <rect class="optimizacion-del-tiempo-hilo" x="79" y="118" width="2" height="86" fill="#f6dca0" />
          <g clip-path="url(#optimizacion-del-tiempo-abajo)">
            <rect class="optimizacion-del-tiempo-arena-abajo" x="30" y="150" width="100" height="58" fill="url(#optimizacion-del-tiempo-arena)" />
          </g>
          <path d="M36 34 H124 C124 78 92 98 82 120 C92 142 124 162 124 206 H36 C36 162 68 142 78 120 C68 98 36 78 36 34 Z" fill="url(#optimizacion-del-tiempo-vidrio)" stroke="#fbf7f1" stroke-opacity=".7" stroke-width="1.6" />
          <!-- frame -->
          <g fill="#b8913f">
            <rect x="22" y="20" width="116" height="14" rx="5" />
            <rect x="22" y="206" width="116" height="14" rx="5" />
          </g>
          <g stroke="#ecc984" stroke-width="5" stroke-linecap="round">
            <path d="M30 34 V206" /><path d="M130 34 V206" />
          </g>
          <path d="M26 24 H134" stroke="#f6dca0" stroke-width="2" stroke-linecap="round" opacity=".7" />
        </svg>
      </div>
      <div class="optimizacion-del-tiempo-sombra"></div>
    </div>
  </div>
  <span class="optimizacion-del-tiempo-caption">Lo importante, primero</span>
</div>

<style is:inline>
  .optimizacion-del-tiempo { position: relative; width: min(100%, 28rem); justify-self: center; display: grid; justify-items: center; gap: .8rem; }
  .optimizacion-del-tiempo-escena { position: relative; width: 100%; aspect-ratio: 1 / 1; perspective: 1000px; transform-style: preserve-3d; }
  .optimizacion-del-tiempo svg { display: block; width: 100%; height: auto; }
  .optimizacion-del-tiempo-caption { color: var(--gold, #b8913f); font-size: clamp(.7rem, 1.15vw, .86rem); letter-spacing: .04em; }

  .optimizacion-del-tiempo-agenda { position: absolute; left: 0; right: 0; top: 4%; transform: rotateX(28deg) rotateZ(-6deg) translateZ(-40px); transform-origin: 50% 100%; filter: drop-shadow(0 26px 34px #21112d66); }
  .optimizacion-del-tiempo-reloj { position: absolute; width: 40%; right: 9%; bottom: 0; transform: translateZ(60px); }
  .optimizacion-del-tiempo-giro { transform-style: preserve-3d; filter: drop-shadow(0 18px 22px #21112d80); }
  .optimizacion-del-tiempo-sombra { width: 78%; height: 1.1rem; margin: -.6rem auto 0; border-radius: 50%; background: radial-gradient(closest-side, #21112d88, transparent); }

  .optimizacion-del-tiempo-arena-arriba, .optimizacion-del-tiempo-arena-abajo { transform-box: fill-box; transform-origin: 50% 100%; }
  /* Still pose: sand halfway, planner complete. */
  .optimizacion-del-tiempo-arena-arriba { transform: scaleY(.55); }
  .optimizacion-del-tiempo-arena-abajo { transform: scaleY(.55); }

  @media (prefers-reduced-motion: no-preference) {
    .optimizacion-del-tiempo-agenda { animation: optimizacion-del-tiempo-flota 16s ease-in-out infinite; }
    .optimizacion-del-tiempo-giro { animation: optimizacion-del-tiempo-girar 16s cubic-bezier(.6, 0, .3, 1) infinite; }
    .optimizacion-del-tiempo-arena-arriba { animation: optimizacion-del-tiempo-vaciar 16s linear infinite; }
    .optimizacion-del-tiempo-arena-abajo { animation: optimizacion-del-tiempo-llenar 16s linear infinite; }
    .optimizacion-del-tiempo-hilo { animation: optimizacion-del-tiempo-caer 16s linear infinite; }
    .optimizacion-del-tiempo-bloques rect { transform-box: fill-box; transform-origin: 50% 50%; animation: optimizacion-del-tiempo-ordenar 16s ease-out infinite; animation-delay: calc(var(--i) * 1.4s - 1s); }
  }

  @keyframes optimizacion-del-tiempo-flota {
    0%, 100% { transform: rotateX(28deg) rotateZ(-6deg) translateZ(-40px); }
    50% { transform: rotateX(24deg) rotateZ(-3deg) translateZ(-40px) translateY(-6px); }
  }
  /* Sand runs for most of the cycle, then the hourglass turns over; since it is symmetric,
     the full bottom becomes the full top and the loop is seamless. */
  @keyframes optimizacion-del-tiempo-girar {
    0%, 80% { transform: rotateY(-12deg) rotateZ(0deg); }
    40% { transform: rotateY(12deg) rotateZ(0deg); }
    100% { transform: rotateY(-12deg) rotateZ(180deg); }
  }
  @keyframes optimizacion-del-tiempo-vaciar { 0% { transform: scaleY(1); } 78%, 100% { transform: scaleY(0); } }
  @keyframes optimizacion-del-tiempo-llenar { 0% { transform: scaleY(0); } 78%, 100% { transform: scaleY(1); } }
  @keyframes optimizacion-del-tiempo-caer { 0%, 76% { opacity: 1; } 80%, 100% { opacity: 0; } }
  @keyframes optimizacion-del-tiempo-ordenar {
    0% { opacity: 0; transform: translateY(-14px) scale(.9); }
    6%, 88% { opacity: 1; transform: none; }
    96%, 100% { opacity: 0; transform: none; }
  }

  @media (max-width: 40rem) { .optimizacion-del-tiempo { width: min(88%, 20rem); } }
</style>

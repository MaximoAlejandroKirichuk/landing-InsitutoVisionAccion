---
// Manual de Ley de Atracción: the ebook opens and lets out its light; little stars rise from the pages,
// gather in the sky above and draw a constellation around a bright central star, then fade.
// The book is CSS 3D (cover and two pages turn on the spine); the detail is inline SVG. No JavaScript.
// Under prefers-reduced-motion the book is shown open, with its light and detail, and still.
---
<div class="ebook-atr" aria-hidden="true">
  <span class="ebook-atr-glow"></span>
  <span class="ebook-atr-shadow"></span>
  <div class="ebook-atr-scene">
    <div class="ebook-atr-book">
      <span class="ebook-atr-back"></span>
      <span class="ebook-atr-block"></span>
      <span class="ebook-atr-page ebook-atr-right"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="ebook-atr-sheet ebook-atr-sheet-2"><span class="ebook-atr-sf"></span><span class="ebook-atr-sb"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></span>
      <span class="ebook-atr-sheet ebook-atr-sheet-1"><span class="ebook-atr-sf"></span><span class="ebook-atr-sb"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></span>
      <div class="ebook-atr-cover">
        <div class="ebook-atr-front">
          <svg viewBox="0 0 40 40" class="ebook-atr-icon"><path d="M20 6 L23 16 L33 17 L25 23 L28 33 L20 27 L12 33 L15 23 L7 17 L17 16 Z" /></svg>
          <span class="ebook-atr-title">Ley de<br />Atracción</span>
          <span class="ebook-atr-sub">Manual de iniciación a la manifestación</span>
          <span class="ebook-atr-brand">Visión en Acción</span>
        </div>
        <div class="ebook-atr-inside"></div>
      </div>
    </div>
  </div>
  <span class="ebook-atr-light"></span>
  <div class="ebook-atr-detail">
    <svg viewBox="0 0 200 120" class="ebook-atr-art">
      <path class="ebook-atr-lines" d="M30 70 L62 38 L100 24 L140 40 L172 66 M62 38 L82 76 L100 24 M140 40 L120 80 L100 24" />
      <path class="ebook-atr-main" d="M100 10 L104 20 L115 21 L107 28 L109 39 L100 33 L91 39 L93 28 L85 21 L96 20 Z" />
      <circle class="ebook-atr-star ebook-atr-star-1" cx="30" cy="70" r="2.6" />
      <circle class="ebook-atr-star ebook-atr-star-2" cx="62" cy="38" r="2.6" />
      <circle class="ebook-atr-star ebook-atr-star-3" cx="140" cy="40" r="2.6" />
      <circle class="ebook-atr-star ebook-atr-star-4" cx="172" cy="66" r="2.6" />
      <circle class="ebook-atr-star ebook-atr-star-5" cx="82" cy="76" r="2.6" />
      <circle class="ebook-atr-star ebook-atr-star-6" cx="120" cy="80" r="2.6" />
    </svg>
  </div>
</div>

<style is:inline>
  .ebook-atr {
    position: relative; width: 100%; aspect-ratio: 1; justify-self: center; isolation: isolate;
    container-type: inline-size; perspective: 1200px; perspective-origin: 50% 20%;
  }
  .ebook-atr-glow {
    position: absolute; inset: 6% 8% 12%; z-index: -2; border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, #d9c3d699 0%, #ae92a655 34%, #6d4f8526 60%, transparent 74%);
    filter: blur(22px);
  }
  .ebook-atr-shadow {
    position: absolute; left: 14%; right: 14%; bottom: 7%; height: 10%; z-index: -1; border-radius: 50%;
    background: radial-gradient(ellipse, rgba(10, 3, 18, .55) 0%, transparent 70%);
  }
  .ebook-atr-scene { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(16deg) rotateY(-8deg); }

  /* The spine is the book's left edge; open, the cover and pages lie to the left of it. */
  .ebook-atr-book {
    position: absolute; left: 31%; top: 40%; width: 38%; height: 50%; transform-style: preserve-3d;
    transform: translateX(0);
  }
  .ebook-atr-book > * { position: absolute; inset: 0; border-radius: 2px 6px 6px 2px; transform-style: preserve-3d; transform-origin: left center; }
  .ebook-atr-back { background: #2a1638; transform: translateZ(-8px); box-shadow: 0 24px 34px -18px rgba(8, 2, 14, .9); }
  .ebook-atr-block { inset: 2% 1% 2% 0; background: repeating-linear-gradient(90deg, #efe4ec 0 1px, #fbf7f1 1px 3px); transform: translateZ(-4px); }
  .ebook-atr-page, .ebook-atr-sf, .ebook-atr-sb {
    background: linear-gradient(90deg, #e6d9e2 0%, #fbf7f1 12%, #fffdf9 100%);
    padding: 16% 12%; display: flex; flex-direction: column; gap: 6%;
  }
  .ebook-atr-page { inset: 2% 1% 2% 0; transform: translateZ(-1px); }
  .ebook-atr-page i, .ebook-atr-sb i { display: block; height: 2px; border-radius: 2px; background: #d9cbdc; }
  .ebook-atr-page i:nth-child(3n), .ebook-atr-sb i:nth-child(2n) { width: 70%; }
  .ebook-atr-sheet { inset: 2% 1% 2% 0; }
  .ebook-atr-sf, .ebook-atr-sb { position: absolute; inset: 0; border-radius: inherit; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .ebook-atr-sb { transform: rotateY(180deg); background: linear-gradient(270deg, #e6d9e2 0%, #fbf7f1 12%, #fffdf9 100%); }
  .ebook-atr-sheet-2 { transform: translateZ(0); }
  .ebook-atr-sheet-1 { transform: translateZ(1px); }
  .ebook-atr-cover { transform: translateZ(3px); }
  .ebook-atr-front, .ebook-atr-inside { position: absolute; inset: 0; border-radius: inherit; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .ebook-atr-front {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4cqw; padding: 10% 9%;
    text-align: center; color: var(--paper, #fbf7f1);
    background:
      radial-gradient(circle at 50% 30%, #ecc98426 0%, transparent 55%),
      linear-gradient(160deg, #5a3474 0%, #3a2050 55%, #2a1638 100%);
    box-shadow: inset 0 0 0 4px #3a2050, inset 0 0 0 5px #ecc98488, inset 6px 0 8px -4px rgba(0, 0, 0, .45);
  }
  .ebook-atr-icon { width: 30%; fill: none; stroke: var(--gold, #ecc984); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .ebook-atr-title { font-family: var(--display, Georgia, serif); font-size: 4.6cqw; line-height: 1.08; }
  .ebook-atr-sub { font-size: 1.9cqw; line-height: 1.35; color: #e6d6ea; }
  .ebook-atr-brand { font-size: 1.5cqw; letter-spacing: .16em; text-transform: uppercase; color: var(--gold, #ecc984); }
  .ebook-atr-inside { transform: rotateY(180deg); background: linear-gradient(270deg, #3a2050, #4a2a62); box-shadow: inset 0 0 0 5px #fbf7f1; }

  /* Light that comes out of the open book, and the detail that floats above it. */
  .ebook-atr-light {
    position: absolute; left: 22%; right: 22%; top: 6%; bottom: 40%; z-index: 1; border-radius: 50% 50% 40% 40%;
    background:
      radial-gradient(ellipse at 50% 100%, #fff6dfee 0%, #f3dfa888 22%, transparent 60%),
      linear-gradient(to top, #fff3d466 0%, #ecc98422 50%, transparent 85%);
    filter: blur(6px); transform-origin: 50% 100%; opacity: 0; transform: scaleY(.2);
    mix-blend-mode: screen; pointer-events: none;
  }
  .ebook-atr-detail { position: absolute; left: 10%; right: 10%; top: 4%; height: 40%; z-index: 2; opacity: 0; transform: translateY(18%) scale(.9); }

  @media (prefers-reduced-motion: no-preference) {
    /* One reading every 14 s: rest, open, let the light out, rest open, close. */
    .ebook-atr-book { animation: ebook-atr-shift 14s cubic-bezier(.45, .05, .25, 1) infinite both; }
    .ebook-atr-cover { animation: ebook-atr-open 14s cubic-bezier(.45, .05, .25, 1) infinite both; }
    .ebook-atr-sheet-1 { --open: -172deg; animation: ebook-atr-turn 14s cubic-bezier(.45, .05, .25, 1) .35s infinite both; }
    .ebook-atr-sheet-2 { --open: -166deg; animation: ebook-atr-turn 14s cubic-bezier(.45, .05, .25, 1) .7s infinite both; }
    .ebook-atr-light { animation: ebook-atr-light 14s ease-in-out infinite both; }
    .ebook-atr-detail { animation: ebook-atr-detail 14s ease-in-out infinite both; }
    .ebook-atr-scene { animation: ebook-atr-sway 20s ease-in-out infinite; }
    .ebook-atr-glow { animation: ebook-atr-glow 7s ease-in-out infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ebook-atr-book { transform: translateX(50%); }
    .ebook-atr-cover { transform: translateZ(3px) rotateY(-178deg); }
    .ebook-atr-sheet-1 { transform: translateZ(1px) rotateY(-172deg); }
    .ebook-atr-sheet-2 { transform: rotateY(-166deg); }
    .ebook-atr-light { opacity: 1; transform: none; }
    .ebook-atr-detail { opacity: 1; transform: none; }
  }
  @keyframes ebook-atr-shift {
    0%, 8% { transform: translateX(0); }
    24%, 80% { transform: translateX(50%); }
    95%, 100% { transform: translateX(0); }
  }
  @keyframes ebook-atr-open {
    0%, 8% { transform: translateZ(3px) rotateY(0deg); }
    24%, 80% { transform: translateZ(3px) rotateY(-178deg); }
    94%, 100% { transform: translateZ(3px) rotateY(0deg); }
  }
  @keyframes ebook-atr-turn {
    0%, 8% { transform: rotateY(0deg); }
    24%, 78% { transform: rotateY(var(--open)); }
    92%, 100% { transform: rotateY(0deg); }
  }
  @keyframes ebook-atr-light {
    0%, 18% { opacity: 0; transform: scaleY(.2); }
    32%, 76% { opacity: 1; transform: scaleY(1); }
    88%, 100% { opacity: 0; transform: scaleY(.2); }
  }
  @keyframes ebook-atr-detail {
    0%, 24% { opacity: 0; transform: translateY(18%) scale(.9); }
    38%, 74% { opacity: 1; transform: translateY(0) scale(1); }
    86%, 100% { opacity: 0; transform: translateY(-6%) scale(1.02); }
  }
  @keyframes ebook-atr-sway { 0%, 100% { transform: rotateX(16deg) rotateY(-8deg); } 50% { transform: rotateX(18deg) rotateY(4deg); } }
  @keyframes ebook-atr-glow { 0%, 100% { opacity: .8; scale: .96; } 50% { opacity: 1; scale: 1.03; } }

  .ebook-atr-art { width: 100%; height: 100%; overflow: visible; fill: none; stroke: #ecc984; stroke-linecap: round; stroke-linejoin: round; }
  .ebook-atr-lines { stroke-width: 1; stroke-dasharray: 3 5; opacity: .7; }
  .ebook-atr-main { fill: #fff3d4; stroke-width: 1.2; filter: drop-shadow(0 0 8px #ecc984); transform-box: fill-box; transform-origin: center; }
  .ebook-atr-star { fill: #fff3d4; stroke: none; filter: drop-shadow(0 0 4px #ecc984); transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .ebook-atr-star { animation: ebook-atr-twinkle 4s ease-in-out infinite; }
    .ebook-atr-star-2 { animation-delay: .6s; } .ebook-atr-star-3 { animation-delay: 1.2s; }
    .ebook-atr-star-4 { animation-delay: 1.8s; } .ebook-atr-star-5 { animation-delay: 2.4s; } .ebook-atr-star-6 { animation-delay: 3s; }
    .ebook-atr-main { animation: ebook-atr-pulse 5s ease-in-out infinite; }
    .ebook-atr-lines { animation: ebook-atr-draw 14s ease-in-out infinite; }
  }
  @keyframes ebook-atr-twinkle { 0%, 100% { opacity: .45; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.3); } }
  @keyframes ebook-atr-pulse { 0%, 100% { transform: scale(.95) rotate(0deg); } 50% { transform: scale(1.08) rotate(8deg); } }
  @keyframes ebook-atr-draw { 0%, 30% { opacity: 0; } 50%, 76% { opacity: .7; } 88%, 100% { opacity: 0; } }
</style>

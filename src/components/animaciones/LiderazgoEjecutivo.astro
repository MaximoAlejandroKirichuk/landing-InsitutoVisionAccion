---
// Liderazgo Ejecutivo: five figures stand scattered on a floor seen in gentle perspective, each facing its own way.
// Little by little they turn and gather into one calm formation, then walk forward together toward a
// golden point on the horizon: a team going in the same direction. Pure SVG + CSS, no JS.
// Only transform and opacity animate. Under prefers-reduced-motion it holds still in the aligned pose.
---
<div class="liderazgo-ejecutivo" aria-hidden="true">
  <div class="liderazgo-ejecutivo-escena">
    <span class="liderazgo-ejecutivo-halo"></span>
    <!-- Floor: concentric rings, tilted back -->
    <div class="liderazgo-ejecutivo-piso">
      <svg viewBox="0 0 400 400" role="presentation" focusable="false">
        <g fill="none" stroke="#ecc984">
          <circle cx="200" cy="200" r="190" stroke-opacity=".22" />
          <circle cx="200" cy="200" r="140" stroke-opacity=".3" stroke-dasharray="2 7" />
          <circle cx="200" cy="200" r="90" stroke-opacity=".35" />
          <circle cx="200" cy="200" r="40" stroke-opacity=".3" stroke-dasharray="2 6" />
        </g>
        <path class="liderazgo-ejecutivo-camino" d="M200 360 V40" stroke="#ecc984" stroke-width="2" stroke-dasharray="4 10" stroke-linecap="round" />
      </svg>
    </div>

    <!-- The goal: a golden point on the horizon -->
    <div class="liderazgo-ejecutivo-meta">
      <svg viewBox="0 0 60 60" role="presentation" focusable="false">
        <circle cx="30" cy="30" r="22" fill="none" stroke="#ecc984" stroke-opacity=".45" />
        <path d="M30 14 L33 27 L46 30 L33 33 L30 46 L27 33 L14 30 L27 27 Z" fill="#f6dca0" />
      </svg>
    </div>

    <!-- Figures: --sx/--sy/--sr scattered pose, --ax/--ay aligned pose (in % of the scene) -->
    <div class="liderazgo-ejecutivo-equipo">
      <div class="liderazgo-ejecutivo-fig" style="--sx:-118%; --sy:-40%; --sr:-18deg; --ax:0%; --ay:-62%; --d:0s">
        <svg viewBox="0 0 40 70"><circle cx="20" cy="12" r="9" fill="#ecc984" /><path d="M6 66 C6 40 12 26 20 26 C28 26 34 40 34 66 Z" fill="#b8913f" /></svg>
      </div>
      <div class="liderazgo-ejecutivo-fig" style="--sx:-170%; --sy:70%; --sr:16deg; --ax:-120%; --ay:-8%; --d:.35s">
        <svg viewBox="0 0 40 70"><circle cx="20" cy="12" r="9" fill="#efe4ef" /><path d="M6 66 C6 40 12 26 20 26 C28 26 34 40 34 66 Z" fill="#9b7fb0" /></svg>
      </div>
      <div class="liderazgo-ejecutivo-fig" style="--sx:150%; --sy:-60%; --sr:22deg; --ax:120%; --ay:-8%; --d:.7s">
        <svg viewBox="0 0 40 70"><circle cx="20" cy="12" r="9" fill="#efe4ef" /><path d="M6 66 C6 40 12 26 20 26 C28 26 34 40 34 66 Z" fill="#9b7fb0" /></svg>
      </div>
      <div class="liderazgo-ejecutivo-fig" style="--sx:-40%; --sy:130%; --sr:-24deg; --ax:-230%; --ay:48%; --d:1.05s">
        <svg viewBox="0 0 40 70"><circle cx="20" cy="12" r="9" fill="#d9c3d6" /><path d="M6 66 C6 40 12 26 20 26 C28 26 34 40 34 66 Z" fill="#6d4f85" /></svg>
      </div>
      <div class="liderazgo-ejecutivo-fig" style="--sx:200%; --sy:110%; --sr:20deg; --ax:230%; --ay:48%; --d:1.4s">
        <svg viewBox="0 0 40 70"><circle cx="20" cy="12" r="9" fill="#d9c3d6" /><path d="M6 66 C6 40 12 26 20 26 C28 26 34 40 34 66 Z" fill="#6d4f85" /></svg>
      </div>
    </div>
  </div>
  <span class="liderazgo-ejecutivo-caption">Todos hacia el mismo lado</span>
</div>

<style is:inline>
  .liderazgo-ejecutivo { position: relative; width: min(100%, 28rem); justify-self: center; display: grid; justify-items: center; gap: .8rem; }
  .liderazgo-ejecutivo-escena { position: relative; width: 100%; aspect-ratio: 1 / 1; perspective: 900px; }
  .liderazgo-ejecutivo svg { display: block; width: 100%; height: auto; overflow: visible; }
  .liderazgo-ejecutivo-caption { color: var(--gold, #b8913f); font-size: clamp(.7rem, 1.15vw, .86rem); letter-spacing: .04em; }

  .liderazgo-ejecutivo-halo { position: absolute; left: 50%; top: 16%; width: 46%; aspect-ratio: 1; margin-left: -23%; border-radius: 50%; background: radial-gradient(closest-side, #ecc98455, transparent); }
  .liderazgo-ejecutivo-piso { position: absolute; left: 4%; right: 4%; top: 22%; transform: rotateX(64deg); transform-origin: 50% 50%; }
  .liderazgo-ejecutivo-camino { opacity: .55; }
  .liderazgo-ejecutivo-meta { position: absolute; left: 50%; top: 20%; width: 12%; margin-left: -6%; }

  /* Figures stand on the floor; the container sets the team's center. */
  .liderazgo-ejecutivo-equipo { position: absolute; left: 50%; top: 58%; width: 0; height: 0; }
  .liderazgo-ejecutivo-fig { position: absolute; width: 3.1rem; left: -1.55rem; top: -2.7rem; filter: drop-shadow(0 10px 8px #21112d80); }
  .liderazgo-ejecutivo-fig::after { content: ""; position: absolute; left: 10%; right: 10%; bottom: -.35rem; height: .7rem; border-radius: 50%; background: radial-gradient(closest-side, #21112d99, transparent); z-index: -1; }
  .liderazgo-ejecutivo-fig svg { position: relative; }
  /* Still pose: aligned, facing the goal. */
  .liderazgo-ejecutivo-fig { transform: translate(var(--ax), var(--ay)); }

  @media (prefers-reduced-motion: no-preference) {
    .liderazgo-ejecutivo-fig { animation: liderazgo-ejecutivo-alinear 15s cubic-bezier(.45, 0, .25, 1) infinite; animation-delay: var(--d); }
    .liderazgo-ejecutivo-meta { animation: liderazgo-ejecutivo-brillo 15s ease-in-out infinite; }
    .liderazgo-ejecutivo-camino { animation: liderazgo-ejecutivo-camino 15s ease-in-out infinite; }
    .liderazgo-ejecutivo-halo { animation: liderazgo-ejecutivo-brillo 15s ease-in-out infinite; }
  }

  /* Scattered and turned away → turn and gather → walk forward together → fade, and start again. */
  @keyframes liderazgo-ejecutivo-alinear {
    0% { opacity: 0; transform: translate(var(--sx), var(--sy)) rotate(var(--sr)) scale(.94); }
    7%, 22% { opacity: 1; transform: translate(var(--sx), var(--sy)) rotate(var(--sr)) scale(.94); }
    46% { opacity: 1; transform: translate(var(--ax), var(--ay)) rotate(0deg) scale(1); }
    56% { opacity: 1; transform: translate(var(--ax), var(--ay)) rotate(0deg) scale(1); }
    84% { opacity: 1; transform: translate(var(--ax), calc(var(--ay) - 70%)) rotate(0deg) scale(.86); }
    94%, 100% { opacity: 0; transform: translate(var(--ax), calc(var(--ay) - 90%)) rotate(0deg) scale(.82); }
  }
  @keyframes liderazgo-ejecutivo-brillo {
    0%, 30% { opacity: .45; transform: scale(.92); }
    55%, 85% { opacity: 1; transform: scale(1.06); }
    100% { opacity: .45; transform: scale(.92); }
  }
  @keyframes liderazgo-ejecutivo-camino {
    0%, 30% { opacity: .1; }
    50%, 85% { opacity: .6; }
    100% { opacity: .1; }
  }

  @media (max-width: 40rem) {
    .liderazgo-ejecutivo { width: min(88%, 20rem); }
    .liderazgo-ejecutivo-fig { width: 2.4rem; left: -1.2rem; top: -2.1rem; }
  }
</style>

---
// Vive del Coaching hero art: an open book (CSS 3D) whose pages turn slowly, one after another, while a
// golden path of steps rises out of the pages toward a small light. Divs + inline SVG, only transform and
// opacity animate, no JS. Under prefers-reduced-motion the book rests open with the whole path lit.
---
<div class="vive-del-coaching" aria-hidden="true">
  <div class="vive-del-coaching-escena">
    <div class="vive-del-coaching-halo"></div>

    <svg class="vive-del-coaching-camino" viewBox="0 0 300 260" role="presentation" focusable="false">
      <defs>
        <radialGradient id="vive-del-coaching-luz" cx=".5" cy=".5" r=".5">
          <stop offset="0" stop-color="#fbe7b6" />
          <stop offset=".5" stop-color="#ecc984" stop-opacity=".7" />
          <stop offset="1" stop-color="#ecc984" stop-opacity="0" />
        </radialGradient>
      </defs>
      <path class="vive-del-coaching-traza" d="M150 250 C150 214 112 200 120 166 C128 132 182 128 176 92 C171 62 150 52 150 30" fill="none" stroke="#ecc984" stroke-opacity=".5" stroke-width="1.4" stroke-dasharray="2 6" stroke-linecap="round" />
      <g fill="#f3dfae">
        <rect class="vive-del-coaching-paso" style="--i:0" x="134" y="228" width="32" height="5" rx="2.5" />
        <rect class="vive-del-coaching-paso" style="--i:1" x="110" y="196" width="28" height="4.6" rx="2.3" />
        <rect class="vive-del-coaching-paso" style="--i:2" x="110" y="160" width="24" height="4.2" rx="2.1" />
        <rect class="vive-del-coaching-paso" style="--i:3" x="152" y="128" width="21" height="3.8" rx="1.9" />
        <rect class="vive-del-coaching-paso" style="--i:4" x="162" y="96" width="18" height="3.4" rx="1.7" />
        <rect class="vive-del-coaching-paso" style="--i:5" x="146" y="66" width="15" height="3" rx="1.5" />
      </g>
      <g class="vive-del-coaching-meta">
        <circle cx="150" cy="30" r="26" fill="url(#vive-del-coaching-luz)" />
        <circle cx="150" cy="30" r="6" fill="#fbe7b6" />
      </g>
      <g class="vive-del-coaching-chispas" fill="#fbe7b6">
        <circle cx="96" cy="120" r="1.4" /><circle cx="206" cy="150" r="1.2" />
        <circle cx="210" cy="70" r="1.5" /><circle cx="88" cy="58" r="1.1" />
      </g>
    </svg>

    <div class="vive-del-coaching-libro">
      <div class="vive-del-coaching-tapa"></div>
      <div class="vive-del-coaching-hoja vive-del-coaching-izq">
        <span class="vive-del-coaching-titulo">Vive del Coaching</span>
        <span class="vive-del-coaching-linea"></span><span class="vive-del-coaching-linea"></span>
        <span class="vive-del-coaching-linea vive-del-coaching-corta"></span>
      </div>
      <div class="vive-del-coaching-hoja vive-del-coaching-der">
        <span class="vive-del-coaching-linea"></span><span class="vive-del-coaching-linea"></span>
        <span class="vive-del-coaching-linea"></span><span class="vive-del-coaching-linea vive-del-coaching-corta"></span>
      </div>
      <div class="vive-del-coaching-hoja vive-del-coaching-der vive-del-coaching-gira" style="--g:0"><span class="vive-del-coaching-linea"></span><span class="vive-del-coaching-linea vive-del-coaching-corta"></span></div>
      <div class="vive-del-coaching-hoja vive-del-coaching-der vive-del-coaching-gira" style="--g:1"><span class="vive-del-coaching-linea"></span><span class="vive-del-coaching-linea vive-del-coaching-corta"></span></div>
      <div class="vive-del-coaching-hoja vive-del-coaching-der vive-del-coaching-gira" style="--g:2"><span class="vive-del-coaching-linea"></span><span class="vive-del-coaching-linea vive-del-coaching-corta"></span></div>
    </div>
  </div>
  <span class="vive-del-coaching-caption">Tu vocación, paso a paso</span>
</div>

<style is:inline>
  .vive-del-coaching { position: relative; width: min(100%, 27rem); justify-self: center; display: grid; justify-items: center; gap: .9rem; perspective: 1100px; }
  .vive-del-coaching-escena { position: relative; width: 100%; aspect-ratio: 10 / 11; transform-style: preserve-3d; }
  .vive-del-coaching-halo { position: absolute; left: 10%; right: 10%; top: 4%; height: 70%; border-radius: 50%; background: radial-gradient(circle, #ecc98433 0%, #6d4f8522 45%, transparent 70%); }
  .vive-del-coaching-camino { position: absolute; left: 12%; width: 76%; top: 0; height: auto; overflow: visible; }
  .vive-del-coaching-caption { color: var(--gold, #b8913f); font-size: clamp(.7rem, 1.15vw, .86rem); letter-spacing: .04em; }

  /* The book: two leaves on a tilted plane, spine in the middle. */
  .vive-del-coaching-libro { position: absolute; left: 50%; bottom: 6%; width: 86%; aspect-ratio: 2 / 1.25; transform: translateX(-50%) rotateX(52deg); transform-style: preserve-3d; filter: drop-shadow(0 30px 34px #21112d66); }
  .vive-del-coaching-tapa { position: absolute; inset: -4% -3%; border-radius: 8px; background: linear-gradient(135deg, #5b3b72, #321a46); box-shadow: inset 0 0 0 1.5px #ecc98466; transform: translateZ(-3px); }
  .vive-del-coaching-hoja { position: absolute; top: 0; bottom: 0; width: 50%; padding: 11% 8% 0; display: flex; flex-direction: column; gap: 9%; background: linear-gradient(90deg, #f6eee3, #fbf7f1 40%); backface-visibility: hidden; }
  .vive-del-coaching-izq { left: 0; border-radius: 6px 0 0 6px; background: linear-gradient(270deg, #e8dccd, #fbf7f1 35%); }
  .vive-del-coaching-der { left: 50%; border-radius: 0 6px 6px 0; transform-origin: 0 50%; }
  .vive-del-coaching-titulo { font-family: var(--font-serif, Georgia, serif); color: #321a46; font-size: clamp(.62rem, 1.5vw, .9rem); line-height: 1.1; }
  .vive-del-coaching-linea { display: block; height: 3px; border-radius: 2px; background: #d9cbdc; }
  .vive-del-coaching-corta { width: 60%; }
  .vive-del-coaching-gira { background: linear-gradient(90deg, #efe4d6, #fbf7f1 30%); box-shadow: -2px 0 6px #321a4614; backface-visibility: visible; }

  /* Reduced motion / first paint: book open, turning leaves flat on the left, every step lit. */
  .vive-del-coaching-gira { transform: rotateY(-178deg); opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .vive-del-coaching-escena { animation: vive-del-coaching-flota 16s ease-in-out infinite; }
    .vive-del-coaching-gira { opacity: 1; transform: rotateY(0deg); animation: vive-del-coaching-pasar 12s cubic-bezier(.45, .05, .35, 1) infinite; animation-delay: calc(var(--g) * 1.3s); }
    .vive-del-coaching-paso { opacity: .2; animation: vive-del-coaching-encender 12s ease-in-out infinite; animation-delay: calc(1.2s + var(--i) * .7s); }
    .vive-del-coaching-traza { animation: vive-del-coaching-respira 12s ease-in-out infinite; }
    .vive-del-coaching-meta { transform-box: fill-box; transform-origin: 50% 50%; animation: vive-del-coaching-brilla 12s ease-in-out infinite; }
    .vive-del-coaching-chispas circle { animation: vive-del-coaching-titila 5s ease-in-out infinite; }
    .vive-del-coaching-chispas circle:nth-child(2n) { animation-delay: -2.5s; }
    .vive-del-coaching-halo { animation: vive-del-coaching-respira 12s ease-in-out infinite; }
  }

  @keyframes vive-del-coaching-flota { 0%, 100% { transform: translateY(0) rotateY(-4deg); } 50% { transform: translateY(-8px) rotateY(4deg); } }
  @keyframes vive-del-coaching-pasar {
    0%, 8% { transform: rotateY(0deg); opacity: 1; }
    30%, 82% { transform: rotateY(-178deg); opacity: 1; }
    90% { transform: rotateY(-178deg); opacity: 0; }
    96% { transform: rotateY(0deg); opacity: 0; }
    100% { transform: rotateY(0deg); opacity: 1; }
  }
  @keyframes vive-del-coaching-encender { 0%, 100% { opacity: .2; } 14%, 70% { opacity: 1; } }
  @keyframes vive-del-coaching-respira { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
  @keyframes vive-del-coaching-brilla { 0%, 30%, 100% { opacity: .5; transform: scale(.85); } 60% { opacity: 1; transform: scale(1.1); } }
  @keyframes vive-del-coaching-titila { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }

  @media (max-width: 40rem) { .vive-del-coaching { width: min(86%, 19.5rem); } }
</style>

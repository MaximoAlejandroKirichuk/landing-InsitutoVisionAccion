---
// Hero art for /perfumes-arcangelicos/: a glass perfume bottle with violet liquid and a gold stopper
// floats and sways gently in 3D; from its neck the aroma rises as threads of light that open into two
// wings, like an archangel's, then fade and rise again. Lilac and gold from the site palette.
// Plain SVG + canvas (no libraries), paused off-screen, DPR capped at 2, fewer particles on phones.
// Under prefers-reduced-motion it draws a single still frame with the wings open.
// No props (convention of src/components/animaciones/). Styles and script are is:inline so only this page loads them.
---
<div class="perfumes-arcangelicos-art" aria-hidden="true">
  <span class="perfumes-arcangelicos-glow"></span>
  <canvas class="perfumes-arcangelicos-canvas" width="600" height="600"></canvas>
  <div class="perfumes-arcangelicos-stage">
    <svg class="perfumes-arcangelicos-bottle" viewBox="0 0 200 260" role="presentation">
      <defs>
        <linearGradient id="pa-glass" x1="0" x2="1">
          <stop offset="0" stop-color="#f4ecfa" stop-opacity=".55" />
          <stop offset=".18" stop-color="#ffffff" stop-opacity=".85" />
          <stop offset=".45" stop-color="#d9c7ea" stop-opacity=".25" />
          <stop offset=".85" stop-color="#b98fd6" stop-opacity=".35" />
          <stop offset="1" stop-color="#f4ecfa" stop-opacity=".6" />
        </linearGradient>
        <linearGradient id="pa-liquid" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#c79be6" />
          <stop offset=".55" stop-color="#8a55b4" />
          <stop offset="1" stop-color="#4d2c64" />
        </linearGradient>
        <linearGradient id="pa-gold" x1="0" x2="1">
          <stop offset="0" stop-color="#b8913f" />
          <stop offset=".35" stop-color="#f6deaa" />
          <stop offset=".7" stop-color="#d7b46a" />
          <stop offset="1" stop-color="#8a6a2c" />
        </linearGradient>
        <clipPath id="pa-body"><path d="M52 112 Q52 96 70 92 L130 92 Q148 96 148 112 L156 214 Q156 240 130 242 L70 242 Q44 240 44 214 Z" /></clipPath>
      </defs>
      <ellipse cx="100" cy="250" rx="62" ry="7" fill="#21112d" opacity=".35" />
      <!-- stopper -->
      <path d="M86 22 Q100 6 114 22 Q120 34 112 44 L88 44 Q80 34 86 22 Z" fill="url(#pa-gold)" />
      <rect x="84" y="44" width="32" height="14" rx="3" fill="url(#pa-gold)" />
      <!-- neck -->
      <rect x="88" y="58" width="24" height="30" rx="4" fill="url(#pa-glass)" stroke="#f4ecfa" stroke-opacity=".6" />
      <!-- body -->
      <g clip-path="url(#pa-body)">
        <rect x="40" y="88" width="120" height="160" fill="#f4ecfa" opacity=".18" />
        <g class="perfumes-arcangelicos-liquid">
          <path d="M30 140 Q65 132 100 140 T170 140 V250 H30 Z" fill="url(#pa-liquid)" opacity=".92" />
        </g>
        <path d="M62 104 Q58 160 64 228" stroke="#fff" stroke-width="6" stroke-linecap="round" opacity=".45" fill="none" />
        <path d="M138 110 Q142 170 136 226" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".3" fill="none" />
      </g>
      <path d="M52 112 Q52 96 70 92 L130 92 Q148 96 148 112 L156 214 Q156 240 130 242 L70 242 Q44 240 44 214 Z" fill="url(#pa-glass)" stroke="#f4ecfa" stroke-opacity=".7" stroke-width="1.5" />
      <!-- label -->
      <rect x="72" y="168" width="56" height="40" rx="6" fill="#fbf7f1" opacity=".9" />
      <path d="M100 176 l3 7 7 1 -5 5 1 7 -6 -3 -6 3 1 -7 -5 -5 7 -1 Z" fill="#b8913f" />
    </svg>
  </div>
  <span class="perfumes-arcangelicos-caption">Un aroma, una intención, tu energía</span>
</div>

<style is:inline>
  .perfumes-arcangelicos-art {
    position: relative; width: 100%; aspect-ratio: 1; justify-self: center;
    display: grid; place-items: center; isolation: isolate;
  }
  .perfumes-arcangelicos-art > * { grid-area: 1 / 1; }
  .perfumes-arcangelicos-glow {
    width: 80%; aspect-ratio: 1; border-radius: 50%; z-index: -1;
    background: radial-gradient(circle at 50% 42%, #ecc98433 0%, #b98fd644 30%, #7a4f9a22 55%, transparent 72%);
    filter: blur(8px);
    animation: perfumes-arcangelicos-breathe 9s ease-in-out infinite;
  }
  .perfumes-arcangelicos-canvas { width: 100%; height: 100%; display: block; }
  .perfumes-arcangelicos-stage {
    align-self: end; width: 34%; margin-bottom: 11%;
    perspective: 700px;
  }
  .perfumes-arcangelicos-bottle {
    display: block; width: 100%; height: auto; transform-origin: 50% 90%;
    filter: drop-shadow(0 10px 22px #21112d66);
    animation: perfumes-arcangelicos-sway 10s ease-in-out infinite;
  }
  .perfumes-arcangelicos-liquid { animation: perfumes-arcangelicos-wave 6s ease-in-out infinite; transform-box: fill-box; }
  .perfumes-arcangelicos-caption {
    align-self: end; margin-bottom: .2rem;
    font: italic 400 .95rem/1.3 var(--display); color: #ecc984cc; letter-spacing: .02em; text-align: center;
  }
  @keyframes perfumes-arcangelicos-breathe { 0%, 100% { scale: .92; opacity: .75; } 50% { scale: 1.06; opacity: 1; } }
  @keyframes perfumes-arcangelicos-sway {
    0%, 100% { transform: translateY(0) rotateY(-16deg) rotateZ(-1.5deg); }
    50% { transform: translateY(-8px) rotateY(16deg) rotateZ(1.5deg); }
  }
  @keyframes perfumes-arcangelicos-wave {
    0%, 100% { transform: translateX(-6px) translateY(0); }
    50% { transform: translateX(6px) translateY(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .perfumes-arcangelicos-glow, .perfumes-arcangelicos-bottle, .perfumes-arcangelicos-liquid { animation: none; }
    .perfumes-arcangelicos-bottle { transform: rotateY(-10deg); }
  }
  @media (max-width: 720px) { .perfumes-arcangelicos-caption { font-size: .85rem; } }
</style>

<script is:inline>
  (() => {
  function start(root) {
    const canvas = root.querySelector('canvas');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = matchMedia('(max-width: 720px)').matches;

    // Wing feathers: quadratic curves fanning out from the bottle neck, on each side.
    const FEATHERS = 7;
    const feathers = [];
    for (const side of [-1, 1]) {
      for (let f = 0; f < FEATHERS; f++) {
        const k = f / (FEATHERS - 1);                 // 0 = top feather, 1 = lowest
        const ang = (0.5 + k * 1.0);                   // radians from vertical
        const len = 1.12 - k * 0.38;
        feathers.push({
          side, k,
          cx: side * (0.04 + k * 0.1), cy: -0.5 - (1 - k) * 0.15,
          ex: side * Math.sin(ang) * len * 1.15, ey: -0.38 - Math.cos(ang) * len * 0.9 + k * 0.05,
        });
      }
    }
    const N = small ? 170 : 300;
    const parts = [];
    for (let i = 0; i < N; i++) {
      parts.push({
        f: feathers[i % feathers.length], u: Math.random(), speed: 0.05 + Math.random() * 0.05,
        jit: (Math.random() - 0.5) * 0.05, ph: Math.random() * 6.28, gold: Math.random() > 0.72,
        r: 0.6 + Math.random() * 1.1,
      });
    }

    let w = 0, h = 0, dpr = 1;
    function resize() {
      dpr = Math.min(devicePixelRatio || 1, 2);
      const box = canvas.getBoundingClientRect();
      w = box.width; h = box.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    new ResizeObserver(() => { resize(); if (reduced) draw(0, 0); }).observe(canvas);

    const bez = (a, b, c, u) => (1 - u) * (1 - u) * a + 2 * (1 - u) * u * b + u * u * c;
    let last = 0;

    function draw(t, dt) {
      // Wings open and close slowly; a gentle turn around the vertical axis gives depth.
      const open = reduced ? 1 : 0.78 + 0.22 * Math.sin(t / 2600);
      const turn = reduced ? 0 : Math.sin(t / 5000) * 0.35;
      const S = Math.min(w, h) * 0.42, ox = w / 2, oy = h * 0.6;
      ctx.clearRect(0, 0, w, h);

      // Soft halo above the bottle where the wings meet.
      const halo = ctx.createRadialGradient(ox, oy - S * 0.5, 0, ox, oy - S * 0.5, S * 0.7);
      halo.addColorStop(0, 'rgba(246, 222, 170, 0.22)');
      halo.addColorStop(1, 'rgba(246, 222, 170, 0)');
      ctx.fillStyle = halo; ctx.fillRect(0, 0, w, h);

      // Faint feather guide lines.
      ctx.lineWidth = 1;
      for (const f of feathers) {
        const depth = 1 + f.side * turn;
        ctx.strokeStyle = `rgba(214, 190, 232, ${0.07 * depth * open})`;
        ctx.beginPath();
        for (let s = 0; s <= 20; s++) {
          const u = s / 20;
          const x = bez(0, f.cx, f.ex * open, u) * (1 - Math.abs(turn) * 0.35) * S;
          const y = bez(0, f.cy, f.ey, u) * S;
          s ? ctx.lineTo(ox + x, oy + y) : ctx.moveTo(ox + x, oy + y);
        }
        ctx.stroke();
      }

      for (const p of parts) {
        if (!reduced) { p.u += p.speed * dt; if (p.u > 1) { p.u = 0; p.ph = Math.random() * 6.28; } }
        const f = p.f, u = p.u;
        const wob = reduced ? 0 : Math.sin(t / 900 + p.ph) * 0.02;
        const x = (bez(0, f.cx, f.ex * open, u) + p.jit * u + wob) * (1 - Math.abs(turn) * 0.35) * S;
        const y = (bez(0, f.cy, f.ey, u) + p.jit * 0.5 * u) * S;
        const depth = 1 + f.side * turn * 0.8;                  // near wing brighter
        const life = Math.sin(Math.PI * Math.min(1, u * 1.15));  // fade in at the neck, out at the tip
        const a = Math.max(0, life * (0.35 + 0.5 * depth) * (0.75 + 0.25 * Math.sin(t / 600 + p.ph * 3)));
        const size = p.r * (1.2 + u * 1.6) * depth * (small ? 0.9 : 1);
        const [r, g, b] = p.gold ? [242, 214, 156] : [218, 194, 240];
        const gr = ctx.createRadialGradient(ox + x, oy + y, 0, ox + x, oy + y, size * 4);
        gr.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${a * 0.6})`);
        gr.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
        ctx.fillStyle = gr;
        ctx.beginPath(); ctx.arc(ox + x, oy + y, size * 4, 0, 6.2832); ctx.fill();
        ctx.fillStyle = `rgba(255, 250, 240, ${a * 0.9})`;
        ctx.beginPath(); ctx.arc(ox + x, oy + y, size * 0.7, 0, 6.2832); ctx.fill();
      }
    }

    if (reduced) {
      for (const p of parts) p.u = 0.15 + Math.random() * 0.8;
      draw(0, 0);
      return;
    }
    let raf = 0, visible = true;
    function loop(t) {
      const dt = last ? Math.min(0.05, (t - last) / 1000) : 0;
      last = t;
      draw(t, dt);
      raf = requestAnimationFrame(loop);
    }
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !raf) { last = 0; raf = requestAnimationFrame(loop); }
      if (!visible && raf) { cancelAnimationFrame(raf); raf = 0; }
    }).observe(root);
  }
  document.querySelectorAll('.perfumes-arcangelicos-art').forEach(start);
  })();
</script>

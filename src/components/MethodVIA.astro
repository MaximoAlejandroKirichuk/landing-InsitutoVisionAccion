---
// MethodVIA — differentiator block placed between hero and quiz.
// Left-aligned on the site's .wrap lines, same card + icon language as ProcessJourney.

const pillars = [
  { id: 'vision', letter: 'V', title: 'Visión', text: 'Comprender lo que hoy está ocurriendo.' },
  { id: 'integration', letter: 'I', title: 'Integración', text: 'Dar un nuevo sentido a la experiencia.' },
  { id: 'action', letter: 'A', title: 'Acción', text: 'Convertir esa comprensión en decisiones concretas.' },
];
---

<section
  id="via-method-differentiator"
  class="via-method"
  aria-labelledby="via-method-heading"
>
  <div class="via-method-shell">
    <header class="via-method-header">
      <p class="via-method-kicker">Nuestro enfoque</p>
      <h2 id="via-method-heading" class="via-method-heading" tabindex="-1">
        ¿Por qué el Método VIA® es diferente?
      </h2>
      <p class="via-method-lead">
        Cada historia es distinta, así que no hay soluciones iguales para todos. Primero comprendemos quién sos y qué querés cambiar; después diseñamos un proceso a tu medida, con tus tiempos y tus recursos.
      </p>
    </header>

    <ol class="via-method-pillars" aria-label="Pilares del Método VIA">
      {pillars.map((pillar) => (
        <li class="via-method-pillar" aria-labelledby={`via-${pillar.id}`}>
          <span class="via-method-icon" aria-hidden="true">
            {pillar.id === 'vision' && (
              <svg viewBox="0 0 24 24"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="3" /></svg>
            )}
            {pillar.id === 'integration' && (
              <svg viewBox="0 0 24 24"><path d="M12 3.5v4M12 16.5v4M3.5 12h4M16.5 12h4" /><circle cx="12" cy="12" r="4.5" /></svg>
            )}
            {pillar.id === 'action' && (
              <svg viewBox="0 0 24 24"><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></svg>
            )}
          </span>
          <span class="via-method-letter" aria-hidden="true">{pillar.letter}</span>
          <h3 id={`via-${pillar.id}`}>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </li>
      ))}
    </ol>

    <p class="via-method-close">
      <span>Comprender para elegir.</span>
      <span>Elegir para actuar.</span>
      <span>Actuar para construir nuevas posibilidades.</span>
    </p>
  </div>
</section>

<style>
  .via-method {
    padding: clamp(2.5rem, 5vw, 4.5rem) 1.25rem;
    position: relative;
    z-index: 1;
  }

  .via-method-shell {
    width: 100%;
    max-width: var(--wrap, 1180px);
    margin: 0 auto;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .via-method-header {
    display: grid;
    gap: 0.85rem;
    max-width: 44rem;
  }

  .via-method-kicker {
    margin: 0;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--via-rust, #b46430);
  }

  .via-method-heading {
    margin: 0;
    outline: none;
  }

  .via-method-lead {
    margin: 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body, #4f3e57);
  }

  .via-method-pillars {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .via-method-pillar {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.4vw, 1.6rem);
    overflow: hidden;
    border: 1px solid var(--line, #d9cbdc);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--paper, #fbf7f1);
  }

  .via-method-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.25rem;
    border-radius: 999px;
    background: var(--soft, #eee4f1);
    color: var(--plum, #321a46);
  }

  .via-method-icon svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Big initial so V-I-A reads as the acronym at a glance. */
  .via-method-letter {
    position: absolute;
    top: 0.4rem;
    right: 1.1rem;
    font-family: var(--display, var(--ff-heading));
    font-size: 4.5rem;
    font-weight: 550;
    line-height: 1;
    color: var(--soft, #eee4f1);
  }

  .via-method-pillar h3 {
    margin: 0;
    font-family: var(--display, var(--ff-heading));
    font-size: 1.25rem;
    font-weight: 550;
    line-height: 1.2;
    color: var(--ink, #24152f);
  }

  .via-method-pillar p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--body, #4f3e57);
  }

  .via-method-close {
    margin: 0;
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    padding: 1.1rem clamp(1.25rem, 2.4vw, 1.6rem);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--plum, #321a46);
    font-family: var(--display, var(--ff-heading));
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.3;
    color: #fff;
  }

  .via-method-close span:last-child {
    color: var(--gold, #ecc984);
  }

  @media (max-width: 960px) {
    .via-method-pillars {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .via-method {
      padding: 2rem 1rem;
    }

    .via-method-close {
      flex-direction: column;
    }
  }
</style>

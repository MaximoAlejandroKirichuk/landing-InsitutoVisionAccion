{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vision-en-accion",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-23",
  // node:crypto and process.env (Apps Script secrets) need Node.js compatibility.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
